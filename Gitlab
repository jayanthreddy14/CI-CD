� Basic GitLab CI/CD Pipeline 
�
� File: .gitlab-ci.yml 
stages: - build - test - deploy 
build: 
stage: build 
script: - echo "Building application..." - mvn clean package 
artifacts: 
paths: - target/*.jar 
test: 
stage: test 
script: - echo "Running tests..." - mvn test 
deploy: 
stage: deploy 
script: - echo "Deploying application..." - scp target/*.jar user@server:/deploy/path 
only: - main



