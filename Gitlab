script: - docker build -t $IMAGE_NAME:latest . 
only: - main 
push: 
stage: push 
script: - echo $CI_REGISTRY_PASSWORD | docker login -u $CI_REGISTRY_USER --password-stdin $CI_REGISTRY - docker push $IMAGE_NAME:latest 
